<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Hier stand einmal
         <uses-feature android:name="android.hardware.type.automotive" />
       mit dem Kommentar, ohne sie erscheine die App im Auto gar nicht.
       Das war falsch und hat die Einreichung im Play Store gekostet:

         «The app cannot declare 'android.hardware.type.automotive'
          device feature and 'com.google.android.gms.car.application'
          metadata at the same time.»

       Die beiden meinen zwei verschiedene Welten. `automotive` ist
       **Android Automotive OS** - das Betriebssystem *im* Auto, ohne
       Telefon. Was HomePilot macht, ist **Android Auto**: Das Telefon
       spiegelt auf den Bildschirm, und dafür genügt die Meta-Angabe
       unten samt dem Dienst. Beides zusammen widerspricht sich, und
       Google lehnt es ab. -->

  <application>
    <!-- Die Anmeldung bei Android Auto: Sie sagt, dass wir mit Vorlagen
         arbeiten (und nicht etwa Medien ausliefern). Ohne sie erscheint
         die App auf dem Autobildschirm gar nicht. -->
    <meta-data
        android:name="com.google.android.gms.car.application"
        android:resource="@xml/automotive_app_desc" />

    <!-- Ab welcher Fassung der Auto-Bibliothek wir laufen. Fehlt die
         Zeile, weist der Host die App ab - und zwar ohne zu sagen,
         warum. -->
    <meta-data
        android:name="androidx.car.app.minCarApiLevel"
        android:value="1" />

    <service
        android:name="ch.stibe.homepilot.auto.HomePilotAutoDienst"
        android:exported="true">
      <intent-filter>
        <action android:name="androidx.car.app.CarAppService" />
        <!-- IoT: Genau die Schublade, in die eine Haussteuerung
             gehört. Ohne eine zugelassene Kategorie lässt Google die
             App nicht ins Auto - das ist der Grund, warum es hier
             Kacheln gibt und keine eigene Oberfläche. -->
        <category android:name="androidx.car.app.category.IOT" />
      </intent-filter>
    </service>
  </application>
</manifest>
