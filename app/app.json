{
  "expo": {
    "name": "HomePilot",
    "slug": "homepilot",
    "owner": "stibe88",
    "version": "0.4.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "ios": {
      "bundleIdentifier": "ch.stibe.homepilot",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.me.stibe.homepilot"
        ]
      }
    },
    "android": {
      "package": "ch.stibe.homepilot",
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d98739fb-4d44-4872-824d-3f89a861749f"
      }
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "@bacons/apple-targets",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "HomePilot meldet dem Hub zuhause, wenn du ankommst oder gehst – damit die Heizung rechtzeitig hochfährt und «alles aus» nicht läuft, während jemand da ist. Es wird nur die Grenze der hinterlegten Orte überwacht, kein laufender Standort.",
          "locationWhenInUsePermission": "HomePilot meldet dem Hub, wenn du zuhause ankommst oder gehst.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager"
    ],
    "scheme": "homepilot",
    "updates": {
      "url": "https://u.expo.dev/d98739fb-4d44-4872-824d-3f89a861749f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
