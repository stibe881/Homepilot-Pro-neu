# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Konfiguration mit Zugangsdaten
hub/config.yaml
# Geheimnisse neben der Konfiguration (siehe core/config.py).
hub/secrets.env

# Der Haushalts-Speicher. Hier stehen im Betrieb Benutzer *samt Tokens*,
# Sitzungen, Push-Geräte und das Zugriffsprotokoll - der Standardpfad ist
# neben der config.yaml (core/config.py). Ein `git add -A` auf dem Hub
# hätte sie sonst mitgenommen. Die leere Fassung liegt als
# homepilot-data.example.json daneben.
hub/homepilot-data.json

# Die Anmeldungen, die sich Integrationen selbst neben den Speicher legen:
# Ring, Google-Kalender, Overkiz, Roborock. Dasselbe Argument.
hub/*-token.json
hub/**/*-token.json

# Die Matter-Fabric: Schlüssel und Zertifikate der gekoppelten Geräte.
# Gehört ins Backup, aber nie ins Repository.
hub/matter/

# Node / Expo
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*

# Native Ordner (werden generiert)
/app/ios
/app/android

# Umgebung
.env
.env*.local

# System
.DS_Store

# Build-Nebenprodukte von setuptools
build/
dist/

# Apple-Push-Schlüssel (Live-Aktivität) - gehört auf den Hub, nie ins Repo.
*.p8
